* text=auto

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Preserve immutable raw-source bytes exactly as captured so provenance hashes
# remain stable across local checkouts and GitHub Actions runners.
raw/** -text
*.pdf binary
