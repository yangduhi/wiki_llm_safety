{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schema/regulation_unit.schema.json",
  "title": "RegulationUnit",
  "type": "object",
  "required": [
    "unit_id",
    "document_id",
    "jurisdiction",
    "regulatory_layer",
    "phase",
    "functional_domain",
    "primary_topic",
    "secondary_topics",
    "actors",
    "components",
    "scenarios",
    "requirements_type",
    "effective_date",
    "source_citation",
    "aliases",
    "confidence",
    "legacy_crosswalk_ids"
  ],
  "properties": {
    "unit_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "jurisdiction": {
      "type": "string",
      "enum": ["KR", "US", "EU", "UNECE"]
    },
    "regulatory_layer": {
      "type": "string",
      "enum": [
        "framework_admin",
        "technical_requirement",
        "test_procedure",
        "conformity_assessment",
        "market_surveillance_recall"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "pre_crash",
        "in_crash",
        "post_crash",
        "cross_phase",
        "non_phase_admin"
      ]
    },
    "functional_domain": {
      "type": "string",
      "enum": [
        "crash_avoidance_and_vehicle_control",
        "occupant_protection_and_restraints",
        "vru_protection",
        "visibility_glazing_and_driver_information",
        "structural_integrity_retention_and_egress",
        "fire_electrical_and_energy_storage_safety",
        "post_crash_response_and_data",
        "interior_materials_and_fire",
        "child_occupant_protection",
        "other_or_review"
      ]
    },
    "primary_topic": { "type": "string", "minLength": 1 },
    "secondary_topics": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "actors": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "components": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "scenarios": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "requirements_type": { "type": "string", "minLength": 1 },
    "effective_date": {
      "type": ["string", "null"],
      "description": "ISO date if known, otherwise null"
    },
    "source_citation": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "legacy_crosswalk_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
